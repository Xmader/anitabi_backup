      },
      "properties": {
        "bangumi_id": 55791,
        "bangumi_title": "笨蛋全裸向前冲",
        "ep_cut": "",
        "image_url": "",
        "location": "",
        "point_id": "jhkqeg6ml",
        "point_name": "名城大学附属図書館",
        "remark": "我在图书馆入口刷过学生证。这是我第一次来图书馆，所以有点生疏。进了图书馆后，左手边不远处放了大量的国际电话与今天的报纸。我很快地看看这一区，并未找到甲斐抄子的身影，于是大步走向下一个地方。\n——《笨蛋全裸向前冲》 第一章 全裸的笨蛋登场"
      },
      "type": "Feature"
    },
    {
